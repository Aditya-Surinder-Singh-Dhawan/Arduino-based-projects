## 💻 Software & Source Code

The project is developed in **Arduino C/C++** using the standard Arduino IDE. It uses the `SoftwareSerial` library to create dedicated serial communication pins for the Bluetooth module, leaving hardware serial pins (0 & 1) free for code uploading and debugging.

### Arduino Code (`bluetooth_car.ino`)

```cpp
#include <SoftwareSerial.h>

// SoftwareSerial (RX, TX)
// Pin 10 -> HC-05 TX
// Pin 11 -> HC-05 RX (via 1k/2k resistor voltage divider)
SoftwareSerial BT(10, 11);

// Left Motor Pins
const int ENA = 3;  // Speed Control (PWM)
const int IN1 = 4;  // Direction
const int IN2 = 5;  // Direction

// Right Motor Pins
const int ENB = 9;  // Speed Control (PWM - Pin 9 supports PWM)
const int IN3 = 6;  // Direction
const int IN4 = 7;  // Direction

// Default Motor Speed (0 - 255)
int motorSpeed = 200;

void setup() {
  // Set all motor control pins as outputs
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  pinMode(ENB, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // Initialize Bluetooth and Hardware Serial Baud Rates
  BT.begin(9600);
  Serial.begin(9600);

  Serial.println("Bluetooth RC Car Ready!");
}

void loop() {
  if (BT.available()) {
    char command = BT.read();
    Serial.println(command);

    if (command == 'F') {
      forward();
    } else if (command == 'B') {
      backward();
    } else if (command == 'L') {
      left();
    } else if (command == 'R') {
      right();
    } else if (command == 'S') {
      stopCar();
    }
  }
}

// Move Forward
void forward() {
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

// Move Backward
void backward() {
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

// Turn Left (Spin on spot: Left wheels back, Right wheels forward)
void left() {
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

// Turn Right (Spin on spot: Left wheels forward, Right wheels back)
void right() {
  analogWrite(ENA, motorSpeed);
  analogWrite(ENB, motorSpeed);

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

// Stop all motors
void stopCar() {
  analogWrite(ENA, 0);
  analogWrite(ENB, 0);

  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}
```

